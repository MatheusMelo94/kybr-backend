{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyInsecureTransport",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": ["arn:aws:s3:::${QUARANTINE_BUCKET}", "arn:aws:s3:::${QUARANTINE_BUCKET}/*"],
      "Condition": { "Bool": { "aws:SecureTransport": "false" } }
    },
    {
      "Sid": "NeverServedByUrlNoPresignedRequests",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": ["arn:aws:s3:::${QUARANTINE_BUCKET}", "arn:aws:s3:::${QUARANTINE_BUCKET}/*"],
      "Condition": { "StringEquals": { "s3:authType": "REST-QUERY-STRING" } }
    },
    {
      "Sid": "DenyPutWithoutSseKms",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::${QUARANTINE_BUCKET}/*",
      "Condition": { "StringNotEquals": { "s3:x-amz-server-side-encryption": "aws:kms" } }
    },
    {
      "Sid": "DenyPutWithAnotherKey",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::${QUARANTINE_BUCKET}/*",
      "Condition": { "StringNotEquals": { "s3:x-amz-server-side-encryption-aws-kms-key-id": "${QUARANTINE_KMS_KEY_ARN}" } }
    },
    {
      "Sid": "OnlyTheApiRoleReadsQuarantinedFiles",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::${QUARANTINE_BUCKET}/*",
      "Condition": { "ArnNotEquals": { "aws:PrincipalArn": "${ROLE_ARN}" } }
    },
    {
      "Sid": "DenyEveryOtherPrincipal",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": ["arn:aws:s3:::${QUARANTINE_BUCKET}", "arn:aws:s3:::${QUARANTINE_BUCKET}/*"],
      "Condition": { "ArnNotEquals": { "aws:PrincipalArn": ["${ROLE_ARN}", "${ADMIN_ARN}"] } }
    }
  ]
}
