{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "FlyOidcThisAppOnly",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::${AWS_ACCOUNT_ID}:oidc-provider/oidc.fly.io/${FLY_ORG}"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "oidc.fly.io/${FLY_ORG}:aud": "sts.amazonaws.com"
        },
        "StringLike": {
          "oidc.fly.io/${FLY_ORG}:sub": "${FLY_ORG}:${FLY_APP}:*"
        }
      }
    }
  ]
}
