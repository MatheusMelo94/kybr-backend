{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteOnlyLogObjects",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": [
        "arn:aws:s3:::kybr-logs-sa-east-1/kybr-api/*",
        "arn:aws:s3:::kybr-logs-sa-east-1/kybr-api-staging/*"
      ]
    }
  ]
}
