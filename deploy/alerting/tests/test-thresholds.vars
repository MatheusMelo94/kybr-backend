# TEST values only, for scripts/ci/check-alerting.sh (rule unit tests). Not the real thresholds,
# which are Fly secrets on the alerting app.
APP_MATCH="kybr-api|kybr-api-staging"
T_LOOKUP_PER_SLUG_15M=100
T_VERIFY_PER_SLUG_15M=50
T_CACHE_READS_PER_SLUG_24H=500
T_CONTACT_LIMITED_1H=5
T_429_PER_POLICY_5M=20
T_IP_UNKNOWN_PER_POLICY_15M=50
T_BFF_REJECTED_5M=100
T_PROVIDER_ERRORS_10M=5
T_5XX_RATIO_5M=0.05
T_5XX_MIN_COUNT_5M=5
SMTP_SMARTHOST="smtp.example.invalid:587"
SMTP_FROM="alerts@example.invalid"
SMTP_USERNAME="test"
ALERT_EMAIL_TO="ops@example.invalid"
