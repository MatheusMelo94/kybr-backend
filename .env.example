# Kybr API environment variables (names only; never put real values in this file).
#
# Local:   cp .env.example .env   (.env is gitignored), or let run-local.sh create it: on first run
#          it appends random dev values for KYBR_BFF_KEY_CURRENT, KYBR_HASH_SECRET,
#          KYBR_IDEMPOTENCY_ENC_KEY, KYBR_PII_ENC_KEY and KYBR_ADMIN_TOKEN when unset, never changing
#          existing ones. Uncomment other lines
#          only to override a profile default. Empty values are ignored by run-local.sh.
# Staging/prod: every variable below is a Fly secret per app (kybr-api-staging, kybr-api),
#          except the non-secret ones marked [fly.toml], which live in fly.toml / fly.prod.toml [env].
#          staging and prod have NO defaults for secrets: the app refuses to start without them.
#
# Generate a 32-byte key:   openssl rand 32 | basenc --base64url
# Generate a Tink keyset:   tinkey create-keyset --key-template AES256_GCM   (then base64 the JSON)

# --- Runtime ---------------------------------------------------------------------------------
# Spring profile: local | docker | staging | prod   [fly.toml]
# SPRING_PROFILES_ACTIVE=
# API port (default 8080)   [fly.toml]
# PORT=
# Management port for health/prometheus, never published (default 8081)   [fly.toml]
# MANAGEMENT_PORT=

# --- Database --------------------------------------------------------------------------------
# MongoDB URI. Local default: replica set rs0 on localhost. Staging/prod: Atlas SRV URI with credentials.
# MONGODB_URI=

# --- BFF key (server-to-server secret shared with the frontend's API_BFF_KEY) ----------------
# base64url, >= 32 random bytes; different per environment.
# KYBR_BFF_KEY_CURRENT=
# Set only during a rotation (same rules; must differ from CURRENT).
# KYBR_BFF_KEY_PREVIOUS=

# --- Hashing (HMAC for rate-limit subjects, idempotency keys, case tokens in logs) -----------
# base64url, >= 32 random bytes.
# KYBR_HASH_SECRET=
# Optional: set for 24 h after a rotation (idempotency lookups only).
# KYBR_HASH_SECRET_PREVIOUS=

# --- Idempotency replay-body encryption ------------------------------------------------------
# Tink AES256_GCM JSON keyset, base64-encoded.
# KYBR_IDEMPOTENCY_ENC_KEY=

# --- Client IP ---------------------------------------------------------------------------------
# Trusted platform header for the socket IP. Empty locally; "Fly-Client-IP" on Fly.   [fly.toml]
# KYBR_CLIENT_IP_PLATFORM_HEADER=

# --- Personal-data encryption (seller contact e-mail) -----------------------------------------
# Tink AES256_GCM JSON keyset, base64-encoded. A different keyset from KYBR_IDEMPOTENCY_ENC_KEY.
# Keep old keys in the keyset until every ciphertext under them is re-encrypted or deleted.
# KYBR_PII_ENC_KEY=

# --- Admin (operator endpoint on the management port only) ------------------------------------
# Bearer token: base64url, >= 32 random bytes.
# KYBR_ADMIN_TOKEN=
# Set only during a rotation (same rules; must differ from KYBR_ADMIN_TOKEN).
# KYBR_ADMIN_TOKEN_PREVIOUS=

# --- Company-data provider (CNPJa) --------------------------------------------------------------
# stub (synthetic fixtures; default everywhere except prod) | live (default in prod)   [fly.toml]
# KYBR_CNPJA_MODE=
# Provider API key: required when live. Prod only (staging only for opt-in contract checks).
# KYBR_CNPJA_API_KEY=
# The plan's monthly credits: required when live (no prod default); 10000 elsewhere.
# A Fly secret (the plan's numbers stay out of the public repo); required in prod.
# KYBR_CNPJA_MONTHLY_CREDITS=
# The plan's per-minute call limit (default 10). A Fly secret; required in prod.
# KYBR_CNPJA_RATE_PER_MINUTE=
