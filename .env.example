# Kybr API environment variables (names only; never put real values in this file).
#
# Local:   cp .env.example .env   (.env is gitignored), or let run-local.sh create it: on first run
#          it appends random dev values for KYBR_BFF_KEY_CURRENT, KYBR_HASH_SECRET,
#          KYBR_IDEMPOTENCY_ENC_KEY, KYBR_PII_ENC_KEY and KYBR_ADMIN_TOKEN when unset, never changing
#          existing ones. Uncomment other lines
#          only to override a profile default. Empty values are ignored by run-local.sh.
# Staging/prod: every variable below is a Fly secret per app (kybr-api-staging, kybr-api),
#          except the non-secret ones marked [fly.toml], which live in fly.toml / fly.prod.toml [env].
#          staging and prod have NO defaults for secrets: the app refuses to start without them.
#
# Generate a 32-byte key:   openssl rand 32 | basenc --base64url
# Generate a Tink keyset:   tinkey create-keyset --key-template AES256_GCM   (then base64 the JSON)

# --- Runtime ---------------------------------------------------------------------------------
# Spring profile: local | docker | staging | prod   [fly.toml]
# SPRING_PROFILES_ACTIVE=
# API port (default 8080)   [fly.toml]
# PORT=
# Management port for health/prometheus, never published (default 8081)   [fly.toml]
# MANAGEMENT_PORT=

# --- Database --------------------------------------------------------------------------------
# MongoDB URI. Local default: replica set rs0 on localhost. Staging/prod: Atlas SRV URI with credentials.
# MONGODB_URI=

# --- BFF key (server-to-server secret shared with the frontend's API_BFF_KEY) ----------------
# base64url, >= 32 random bytes; different per environment.
# KYBR_BFF_KEY_CURRENT=
# Set only during a rotation (same rules; must differ from CURRENT).
# KYBR_BFF_KEY_PREVIOUS=

# --- Hashing (HMAC for rate-limit subjects, idempotency keys, case tokens in logs) -----------
# base64url, >= 32 random bytes.
# KYBR_HASH_SECRET=
# Optional: set for 24 h after a rotation (idempotency lookups only).
# KYBR_HASH_SECRET_PREVIOUS=

# --- Idempotency replay-body encryption ------------------------------------------------------
# Tink AES256_GCM JSON keyset, base64-encoded.
# KYBR_IDEMPOTENCY_ENC_KEY=

# --- Client IP ---------------------------------------------------------------------------------
# Trusted platform header for the socket IP. Empty locally; "Fly-Client-IP" on Fly.   [fly.toml]
# KYBR_CLIENT_IP_PLATFORM_HEADER=

# --- Personal-data encryption (seller contact e-mail) -----------------------------------------
# Tink AES256_GCM JSON keyset, base64-encoded. A different keyset from KYBR_IDEMPOTENCY_ENC_KEY.
# Keep old keys in the keyset until every ciphertext under them is re-encrypted or deleted.
# KYBR_PII_ENC_KEY=

# --- Admin (operator endpoint on the management port only) ------------------------------------
# Bearer token: base64url, >= 32 random bytes.
# KYBR_ADMIN_TOKEN=
# Set only during a rotation (same rules; must differ from KYBR_ADMIN_TOKEN).
# KYBR_ADMIN_TOKEN_PREVIOUS=

# --- Company-data provider (CNPJa) --------------------------------------------------------------
# stub (synthetic fixtures; default everywhere except prod) | live (default in prod)   [fly.toml]
# KYBR_CNPJA_MODE=
# Provider API key: required when live. Prod only (staging only for opt-in contract checks).
# KYBR_CNPJA_API_KEY=
# The plan's monthly credits: required when live (no prod default); 10000 elsewhere.
# A Fly secret (the plan's numbers stay out of the public repo); required in prod.
# KYBR_CNPJA_MONTHLY_CREDITS=
# The plan's per-minute call limit (default 60, a placeholder). A Fly secret; required in prod.
# KYBR_CNPJA_RATE_PER_MINUTE=

# --- Seller document upload ------------------------------------------------------------------------
# Where multipart parts are written (always to disk). Absolute; a dedicated, size-bounded directory
# (a tmpfs on Fly), wiped at startup. Default: <java.io.tmpdir>/kybr-uploads   [fly.toml]
# KYBR_UPLOAD_TEMP_DIR=
# Origins the seller's browser may upload from (staging only; comma-separated exact origins).   [fly.toml]
# KYBR_CORS_D6_ORIGINS=
# At most one anchored regular expression for the frontend's preview origins (staging only).   [fly.toml]
# KYBR_CORS_D6_ORIGIN_PATTERN=

# --- Malware scanner (isolated, mutual TLS) -----------------------------------------------------
# stub (test signatures only; default everywhere except prod) | clamd (default in prod)   [fly.toml]
# KYBR_SCANNER_MODE=
# Scanner host name (checked against its certificate) and TLS port (default 3310). Required for clamd.   [fly.toml]
# KYBR_SCANNER_HOST=
# KYBR_SCANNER_PORT=
# base64 SHA-256 of the scanner certificate's public key (the pin). Required for clamd. A Fly secret,
# rotated together with the link certificates; required in prod.
# KYBR_SCANNER_SPKI_SHA256=
# This API's client certificate, its private key (PKCS#8) and the link's private CA, PEM. Required for clamd.
# The key is a secret; all three are Fly secrets, required in prod.
# KYBR_SCANNER_CLIENT_CERT=
# KYBR_SCANNER_CLIENT_KEY=
# KYBR_SCANNER_CA=
# Photo re-encoding: in-process-test (metadata stripped in process, no decode, synthetic photos only;
# default everywhere except prod) | remote (the sanitizer service; default in prod)   [fly.toml]
# KYBR_IMAGE_MODE=
# Photo sanitizer service next to the scanner (same TLS material as the scanner, which is then required
# even with the stub scanner). Required in remote mode.   [fly.toml]
# KYBR_SANITIZER_HOST=
# KYBR_SANITIZER_PORT=
# The asynchronous scan job (default true): uploads wait in quarantine until it scans them. Off only
# in tests; prod refuses false.
# KYBR_SCAN_ENABLED=

# --- Document storage ----------------------------------------------------------------------------
# memory (default everywhere except prod) | s3 (default in prod)   [fly.toml]
# KYBR_STORAGE_MODE=
# Private bucket and the KMS key every object is encrypted under (the full key ARN: the bucket policy
# compares it with the key id sent on every put). Required for s3. Fly secrets (they identify the cloud
# account, so they stay out of the public repo); required in prod.
# KYBR_STORAGE_BUCKET=
# KYBR_STORAGE_KMS_KEY_ID=
# The quarantine, where received files wait until the scan job accepts them: its own bucket and its
# own KMS key, readable only by the API's role. Required in prod.
# Never served or signed as a URL: its bucket policy refuses presigned requests.
# KYBR_STORAGE_QUARANTINE_BUCKET=
# KYBR_STORAGE_QUARANTINE_KMS_KEY_ID=
# Role assumed with the platform's identity token. Required for s3 unless the static keys are set.
# A Fly secret; required in prod.
# KYBR_AWS_ROLE_ARN=
# The same role ARN under the platform's own name: Fly provides the identity token file only when this
# is set. A Fly secret; required in prod (same value as KYBR_AWS_ROLE_ARN).
# AWS_ROLE_ARN=
# Static-key fallback only (both or neither). Secrets.
# KYBR_AWS_ACCESS_KEY_ID=
# KYBR_AWS_SECRET_ACCESS_KEY=

# --- E-mail --------------------------------------------------------------------------------------
# recording (kept in memory, never sent; default everywhere except prod) | resend (default in prod)   [fly.toml]
# KYBR_EMAIL_MODE=
# E-mail provider API key (sending access to the one domain only). Required for resend. A Fly secret;
# required in prod.
# KYBR_RESEND_API_KEY=
# true only once the sending domain's DKIM, SPF and DMARC records are published (default false).   [fly.toml]
# KYBR_EMAIL_DNS_VERIFIED=
# The only addresses the operator test e-mail may go to (comma-separated). A Fly secret (personal
# addresses stay out of the repo).
# KYBR_EMAIL_TEST_RECIPIENTS=
# The notice to a seller's previous address after a contact change (default false: no copy yet).   [fly.toml]
# KYBR_EMAIL_CONTATO_ALTERADO_ENABLED=
